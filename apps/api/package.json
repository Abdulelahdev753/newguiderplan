{
  "name": "@guiderplan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@guiderplan/shared": "*",
    "@supabase/supabase-js": "^2.117.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "~5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
