PORT=4000

# Comma-separated origins allowed to call the API cross-origin.
# Defaults to http://localhost:3000 in development and to none in production,
# where Express serves the frontend from the same origin.
# CORS_ORIGIN=http://localhost:3000

# Folder holding the Next.js static export. Defaults to ../web/out.
# WEB_DIST_DIR=

# The address buyers see, with no trailing slash. StreamPay sends them back here
# after paying. Defaults to http://localhost:3000 in development.
PUBLIC_SITE_URL=https://guiderplan.com

# How many proxies sit in front of this server (1 for a single load balancer).
# Rate limits are per visitor IP, so a wrong value either lumps every visitor
# together (too low) or lets a visitor fake their IP (too high).
# TRUST_PROXY=1

# Supabase: Project Settings -> API. The secret key bypasses row level security;
# never expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# StreamPay: Settings -> API keys. The value sent in the x-api-key header.
STREAM_API_KEY=

# StreamPay: Settings -> Webhooks. The secret of the webhook pointing at
# <PUBLIC_SITE_URL>/api/webhooks/stream (events: PAYMENT_SUCCEEDED, PAYMENT_REFUNDED).
STREAM_WEBHOOK_SECRET=
